# CampusGuard AI settings. Copy this file to ".env" in the same folder, fill in what you have,
# then (re)start the server. The real .env is git-ignored, so your key is never pushed.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Leave it empty to run with the rule engine only.
GEMINI_API_KEY=

# ---- Optional -------------------------------------------------------------------------------

# Model to try first. If your key can't use it, the app falls back to gemini-2.5-flash.
# GEMINI_MODEL=gemini-3-flash-preview

# Google Safe Browsing key for link checks (a separate key from Gemini).
# SAFE_BROWSING_API_KEY=

# Optional: protect ONE university more closely (leave all three out for the generic mode).
# With these set, the page says "...for National Taipei University Students", a one-letter slip of
# your domain (ntpuu.edu.tw, ntpu.org) is flagged as a lookalike, and a "go to the real portal" button
# appears next to every suspicious or login-page result. Use your university's real sign-in page.
# CAMPUS_NAME=National Taipei University
# CAMPUS_DOMAINS=ntpu.edu.tw
# CAMPUS_PORTAL_URL=https://www.ntpu.edu.tw/

# Score at or above which a scan counts as phishing in the Evaluation tab (default 60).
# PHISHING_THRESHOLD=60

# Redis for the trusted-domain list. Without Redis the app uses a built-in list in memory.
# Note: a Redis server that already holds an older list keeps it. The built-in list is only copied in when Redis is empty.
# REDIS_URL=redis://localhost:6379/0
