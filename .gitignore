# Virtual environment & Python cache
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local SQLite database & runtime caches
*.db
*.db-journal
*.sqlite3

# Evaluation caches (Gemini responses may cost quota to regenerate, but are machine-local)
eval/cache/

# Environment variables & secrets
.env
.env.*
!.env.example

